# Settings — LAB / HOME (локальный keycloak-dev). Copy → docker/.env
# Compose: docker-compose.yml + docker-compose.lab.yml
#
# Стек: traefik_proxy + ai-agents/traefik; LLM — LM Studio на хосте (OpenAI-compatible :1234).
#
#   docker compose -f docker-compose.yml -f docker-compose.lab.yml \
#     --env-file docker/.env --env-file docker/.env.secrets up -d --build
#
# PostgreSQL — НА ХОСТЕ: сервиса postgres в Compose нет. DATABASE_URL в
# docker/.env.secrets смотрит на host.docker.internal:5432/ai_agents;
# схему накатывает ai-agents-migrate (alembic upgrade head).
# OIDC уходит в локальный keycloak-dev (realm ai-agents, :8443, file-router
# keycloak.example.com); маршрутизацию задаёт docker-compose.lab.yml.

APP_NAME=ai-agents
ENVIRONMENT=development
BACKEND_PUBLISH_PORT=8096
# Host-published ports (containers listen on 8080/80).
FRONTEND_PUBLISH_PORT=4196

PROJECT_HOST=ai-agents-dev.example.com
PUBLIC_URL=https://ai-agents-dev.example.com

# --- Keycloak OIDC ---
# Issuer/public URL те же, что на work: их задаёт KC_HOSTNAME_URL локального KC.
# Host, который должен резолвиться в Docker host gateway (lab: локальный IdP через Traefik).
KEYCLOAK_HOST=keycloak.example.com
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/ai-agents
KEYCLOAK_PUBLIC_URL=https://keycloak.example.com
KEYCLOAK_REALM=ai-agents
KEYCLOAK_CLIENT_ID=ai-agents
KEYCLOAK_REDIRECT_URI=https://ai-agents-dev.example.com/auth/callback
# lab-certs самоподписанные → проверку TLS выключаем, CA-бандл пустой.
KEYCLOAK_SSL_VERIFY=false
KEYCLOAK_CA_BUNDLE=

# --- Session / admin ---
ADMIN_ROLES=ai-agents-admin
# Аккаунты, всегда получающие роль superadmin (bootstrap, без realm-ролей)
SUPERADMIN_EMAILS=admin@example.com
# Каталог пользователей Keycloak: нужен клиент с realm-management view-users.
# По умолчанию используется основной клиент KEYCLOAK_CLIENT_ID/SECRET.
# DIRECTORY_ADMIN_CLIENT_ID=ai-agents-admin
# DIRECTORY_ADMIN_CLIENT_SECRET=
SESSION_COOKIE_NAME=ai_agents_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=8

# --- Langfuse (optional) ---
LANGFUSE_HOST=http://localhost:3000

# --- Run caps ---
MAX_STEPS_CAP=32
RUN_TIMEOUT_CAP_SECONDS=600
# Private MCP endpoint on the Docker host (e.g. `docker mcp gateway run --transport streaming`).
MCP_EGRESS_ALLOWED_HOSTS=host.docker.internal

# LM Studio on the Docker host.
DEFAULT_LLM_BASE_URL=http://host.docker.internal:1234/v1
DEFAULT_LLM_MODEL=local-model

RUN_TIMEOUT_SECONDS=120
MAX_STEPS=8

STORAGE_PATH=/data
LOG_DIR=/data/logs
# SKILLS_IMPORT_ROOTS=/data/skills

POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=ai_agents
POSTGRES_USER=postgres
