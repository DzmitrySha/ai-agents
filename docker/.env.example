# Settings — WORK / shared lab. Copy → docker/.env
#
# Shared Traefik network: `traefik_proxy`.
# FQDN lab/work: https://ai-agents-dev.example.com
# FQDN prod k8s: https://ai-agents.example.com  (не копировать -dev в ConfigMap)
#
# PostgreSQL — на хосте (в Compose сервиса postgres нет): см. POSTGRES_* ниже,
# DATABASE_URL живёт в docker/.env.secrets.
# Traefik → frontend (nginx) → backend; backend публикует ${BACKEND_PORT} для API.

APP_NAME=ai-agents
ENVIRONMENT=development
BACKEND_PUBLISH_PORT=8096
# Host-published ports (containers listen on 8080/80).
FRONTEND_PUBLISH_PORT=4196

PROJECT_HOST=ai-agents-dev.example.com
PUBLIC_URL=https://ai-agents-dev.example.com
# Optional extras for MCP DNS-rebinding allowlist (comma-separated Host values).
# Built-in: PUBLIC_URL host, localhost, 127.0.0.1, host.docker.internal.
# MCP_ALLOWED_HOSTS=
# Private MCP endpoints allowed OUTBOUND (MCP connections only; host, *.suffix, IP/CIDR).
# Custom tools stay public-only. Lab: Docker MCP Gateway on the host → host.docker.internal.
# MCP_EGRESS_ALLOWED_HOSTS=host.docker.internal

# --- Keycloak OIDC (BFF cookie) ---
# Issuer одинаков для браузера и backend. KEYCLOAK_CLIENT_SECRET — в docker/.env.secrets.
# Host, который должен резолвиться в Docker host gateway (lab: локальный IdP через Traefik).
KEYCLOAK_HOST=keycloak.example.com
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/ai-agents
KEYCLOAK_PUBLIC_URL=https://keycloak.example.com
KEYCLOAK_REALM=ai-agents
KEYCLOAK_CLIENT_ID=ai-agents
KEYCLOAK_REDIRECT_URI=https://ai-agents-dev.example.com/auth/callback
# Путь к CA-бандлу внутри контейнера (k8s: /certs/ca.crt) или пусто.
KEYCLOAK_CA_BUNDLE=
KEYCLOAK_SSL_VERIFY=false

# --- Session / admin ---
# SESSION_SECRET_KEY — секрет, только docker/.env.secrets.
ADMIN_ROLES=ai-agents-admin
# Аккаунты, всегда получающие роль superadmin (bootstrap, без realm-ролей)
SUPERADMIN_EMAILS=admin@example.com
# Каталог пользователей Keycloak: нужен клиент с realm-management view-users.
# По умолчанию используется основной клиент KEYCLOAK_CLIENT_ID/SECRET.
# DIRECTORY_ADMIN_CLIENT_ID=ai-agents-admin
# DIRECTORY_ADMIN_CLIENT_SECRET=
SESSION_COOKIE_NAME=ai_agents_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=8

# --- Langfuse (optional) ---
# Ключи LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY — docker/.env.secrets.
LANGFUSE_HOST=http://localhost:3000

# --- Run caps ---
MAX_STEPS_CAP=32
RUN_TIMEOUT_CAP_SECONDS=600
# Роль user: запусков в сутки (0 = без лимита)
USER_DAILY_RUN_LIMIT=20

# Default OpenAI-compatible LLM; clients may override per run.
DEFAULT_LLM_BASE_URL=http://host.docker.internal:1234/v1
DEFAULT_LLM_MODEL=local-model
# Optional; secrets go to docker/.env.secrets.
# DEFAULT_LLM_API_KEY=not-needed

RUN_TIMEOUT_SECONDS=120
MAX_STEPS=8

# Compose bind ./storage → /data; k8s PVC ai-agents-data → /data
STORAGE_PATH=/data
LOG_DIR=/data/logs
# Доп. корни для POST /v1/skills/import-local {path}; пусто = только STORAGE_PATH
# SKILLS_IMPORT_ROOTS=/data/skills,/opt/skills

# PostgreSQL на хосте; DATABASE_URL — в docker/.env.secrets.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=ai_agents
POSTGRES_USER=postgres
