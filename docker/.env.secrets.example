# Secrets only. Copy to docker/.env.secrets — NEVER commit real values.
# One or more service keys (comma/space separated). Required by /v1/*.
SERVICE_API_KEYS=CHANGE_ME_SERVICE_KEY

# Optional default LLM API key (for remote OpenAI-compatible endpoints).
# DEFAULT_LLM_API_KEY=CHANGE_ME

# Keycloak confidential client secret (realm ai-agents, client ai-agents).
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
# BFF session cookie signer — long random string.
SESSION_SECRET_KEY=CHANGE_ME_LONG_RANDOM

# Langfuse tracing (optional, empty = выключено).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

POSTGRES_PASSWORD=postgres
# PostgreSQL на хосте (в Compose сервиса postgres нет).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/ai_agents

# Optional: raise GitHub API rate limit for skills.sh imports (read-only token).
GITHUB_TOKEN=
# Optional: Vercel OIDC token for the official skills.sh API (search/detail).
SKILLS_SH_TOKEN=
